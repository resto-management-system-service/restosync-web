  "info": {
    "title": "RestoSync API",
    "description": "Restaurant management API — menu, orders, payments",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@example.com"
          },
          "password": {
            "type": "string",
            "example": "Secret123!",
            "minLength": 8
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "+1 555 010 0199"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@restosync.local"
          },
          "password": {
            "type": "string",
            "example": "Admin123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Burgers"
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Burgers"
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CreateMenuItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Classic Cheeseburger"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "example": 1200,
            "description": "Price in integer cents"
          },
          "currency": {
            "type": "string",
            "default": "usd"
          },
          "imageUrl": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "default": true
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "priceCents",
          "categoryId"
        ]
      },
      "UpdateMenuItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Classic Cheeseburger"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "number",
            "example": 1200,
            "description": "Price in integer cents"
          },
          "currency": {
            "type": "string",
            "default": "usd"
          },
          "imageUrl": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "default": true
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OrderLineDto": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1
          },
          "modifiers": {
            "type": "object",
            "description": "Free-form modifiers (e.g. { \"size\": \"L\", \"extras\": [\"bacon\"] })"
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineDto"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "PREPARING",
              "READY",
              "COMPLETED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateIntentDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid",
            "description": "Order to pay for"
          }
        },
        "required": [
          "orderId"
        ]
      }
    }
  }
}